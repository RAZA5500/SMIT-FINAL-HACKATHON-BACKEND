# ─────────────────────────────────────────────────────────────
# HCM Lite backend — copy this file to `.env` and fill it in.
# ─────────────────────────────────────────────────────────────

# HTTP port the API listens on (all routes are under /api)
PORT=3000

# MongoDB connection string (the database starts completely empty)
DATABASE_URL=mongodb://127.0.0.1:27017/hcm_lite

# JWT signing secret — use a long random string (min 32 chars) in production
JWT_SECRET=replace-with-a-long-random-secret-string-of-32-chars-or-more
# Optional: token lifetime (default 1d)
JWT_EXPIRES_IN=1d

# AI assistant (Anthropic Claude). Read on the server only — never sent to clients.
# Leave AI_API_KEY empty to run without AI (endpoints return friendly fallbacks).
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# Optional first-run bootstrap: if BOTH are set and the system is not initialized yet,
# the server creates the CompanySettings + first Admin account on startup.
# Otherwise use POST /api/setup/init from the setup screen.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Optional ──────────────────────────────────────────────────
# Company name / admin name / timezone used by the startup bootstrap above
COMPANY_NAME=
ADMIN_FULL_NAME=
APP_TIMEZONE=Asia/Karachi
# Comma-separated list of allowed browser origins (default: allow all)
CORS_ORIGIN=
# General API rate limit per user (or IP) per minute (AI is fixed at 20/user/hour)
THROTTLE_LIMIT=300
